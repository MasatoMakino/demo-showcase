{
  "name": "@masatomakino/demo-showcase",
  "version": "0.1.3",
  "description": "Generate demo HTML pages from JS/TS source files using Vite",
  "keywords": [
    "demo",
    "html-generator",
    "static-site",
    "typescript"
  ],
  "homepage": "https://github.com/MasatoMakino/demo-showcase#readme",
  "bugs": {
    "url": "https://github.com/MasatoMakino/demo-showcase/issues"
  },
  "license": "MIT",
  "author": "MasatoMakino <unagiinu.g@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MasatoMakino/demo-showcase.git"
  },
  "bin": {
    "demo-showcase": "bin/CLI.js"
  },
  "directories": {
    "doc": "docs"
  },
  "files": [
    "bin",
    "template"
  ],
  "type": "module",
  "main": "bin/CLI.js",
  "scripts": {
    "test": "vp test --run && pnpm run build && pnpm run testRun",
    "test:watch": "vp test",
    "coverage": "vp test --run --coverage",
    "build": "tsc",
    "watch": "tsc -W",
    "testRun": "node ./bin/CLI.js build --srcDir ./demoSrc",
    "lint": "vp check",
    "dev": "node ./bin/CLI.js dev --srcDir ./demoSrc --host 0.0.0.0",
    "pre-commit": "vp check --fix --no-error-on-unmatched-pattern"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "glob": "^14.0.2",
    "mrmime": "^2.0.1",
    "vite": "^8.3.8",
    "vite-plugin-full-reload": "^1.2.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@vitest/coverage-istanbul": "catalog:",
    "typescript": "^7.0.2",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@12.16.1"
}
